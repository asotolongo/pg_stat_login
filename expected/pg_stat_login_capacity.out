DROP PROCEDURE cap_hold_connections();
DROP PROCEDURE cap_fill(int, int);
DROP FUNCTION cap_try_connect(text);
DROP DATABASE cap_db1;
DROP DATABASE cap_db2;
DROP ROLE cap_plain;
DROP EXTENSION pg_stat_login;
DROP EXTENSION dblink;
